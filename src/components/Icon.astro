---
// References a symbol from IconSprite.astro (rendered once per page by Base.astro).
import type { IconName } from '../lib/icons';

export type { IconName };

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: cls } = Astro.props;
---

<svg class:list={['icon', cls]} viewBox="0 0 256 256" fill="currentColor" aria-hidden="true" focusable="false"><use href={`#i-${name}`} /></svg>
