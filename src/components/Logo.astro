---
interface Props {
  inverse?: boolean;
}
const { inverse = false } = Astro.props;
---

<span class:list={['logo', { 'logo--inverse': inverse }]}>
  <svg class="logo__mark" viewBox="0 0 24 34" aria-hidden="true" focusable="false">
    <line x1="12" y1="0" x2="12" y2="11" />
    <path d="M6.5 11h11v7.5L12 32 6.5 18.5Z" />
  </svg>
  <span class="logo__word">отвес</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: flex-end;
    gap: 0.45rem;
    color: var(--ink);
    line-height: 1;
  }
  .logo--inverse { color: var(--on-inverse); }
  .logo__mark {
    width: 17px;
    height: 24px;
    overflow: visible;
    transform-origin: 12px 0;
  }
  .logo__mark line { stroke: currentColor; stroke-width: 1.6; }
  .logo__mark path { fill: var(--signal); stroke: currentColor; stroke-width: 1.6; stroke-linejoin: round; }
  .logo__word {
    font-size: 1.5rem;
    font-weight: 760;
    letter-spacing: -0.045em;
    font-variation-settings: 'SHRP' 100;
    line-height: 0.8;
  }

  /* The plumb bob settles to true vertical, the brand in one gesture. */
  @media (prefers-reduced-motion: no-preference) {
    :global(a:hover) > .logo .logo__mark,
    :global(a:focus-visible) > .logo .logo__mark {
      animation: swing 1.1s var(--ease-out);
    }
  }
  @keyframes swing {
    0% { transform: rotate(0); }
    20% { transform: rotate(9deg); }
    45% { transform: rotate(-6deg); }
    68% { transform: rotate(3deg); }
    86% { transform: rotate(-1deg); }
    100% { transform: rotate(0); }
  }
</style>
