---
import { Picture } from 'astro:assets';
import before from '../../assets/photos/stairs-before.jpg';
import after from '../../assets/photos/stairs-after-aligned.jpg';

const sizes = '(max-width: 1360px) 96vw, 1280px';
---

<figure class="ba" data-ba>
  <div class="ba__frame">
    <Picture src={after} alt="После ремонта: гостиная с лестницей, паркетом, подсветкой ступеней и настенным светильником" formats={['avif', 'webp']} widths={[640, 960, 1280, 1800]} sizes={sizes} class="ba__img" loading="lazy" />
    <div class="ba__before" aria-hidden="true">
      <Picture src={before} alt="" formats={['avif', 'webp']} widths={[640, 960, 1280, 1800]} sizes={sizes} class="ba__img" loading="lazy" />
    </div>
    <span class="ba__tag ba__tag--before" aria-hidden="true">Было</span>
    <span class="ba__tag ba__tag--after" aria-hidden="true">Стало</span>
    <div class="ba__handle" aria-hidden="true"><span></span></div>
    <input
      class="ba__range"
      type="range"
      min="0"
      max="100"
      step="1"
      value="50"
      aria-label="Сравнение до и после ремонта"
      aria-valuetext="Пополам: слева фото до ремонта, справа после"
      data-ba-range
    />
  </div>
  <figcaption class="ba__caption">
    <span>До ремонта гостиная выглядела так: лестница и камин укрыты защитным полотном, на полу строительный картон. Сдвиньте ползунок, чтобы сравнить.</span>
    <span class="ba__credit">Фото: immo RENOVATION на Unsplash, реальный ремонт в Швейцарии, используется как демо-иллюстрация.</span>
  </figcaption>
</figure>

<style>
  .ba { --pos: 50%; }
  .ba__frame {
    position: relative;
    overflow: hidden;
    border-radius: var(--r-m);
    aspect-ratio: 16 / 9;
    max-height: 80vh;
    width: 100%;
    background: var(--sunken);
    user-select: none;
  }
  .ba :global(.ba__img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .ba__before { position: absolute; inset: 0; clip-path: inset(0 calc(100% - var(--pos)) 0 0); }
  .ba__handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 3px;
    margin-left: -1.5px;
    background: var(--signal);
    pointer-events: none;
  }
  .ba__handle span {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 48px;
    height: 48px;
    margin: -24px 0 0 -24px;
    border-radius: 50%;
    background: var(--signal);
    border: 2px solid var(--on-signal);
    box-shadow: 0 6px 18px rgb(0 0 0 / 0.25);
  }
  /* Two arrows inside the knob say «drag sideways». */
  .ba__handle span::before, .ba__handle span::after {
    content: '';
    position: absolute;
    top: 50%;
    width: 9px;
    height: 9px;
    border: solid var(--on-signal);
    border-width: 0 0 2.5px 2.5px;
  }
  .ba__handle span::before { left: 9px; transform: translateY(-50%) rotate(45deg); }
  .ba__handle span::after { right: 9px; transform: translateY(-50%) rotate(-135deg); }
  .ba__range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
    touch-action: pan-y;
  }
  .ba:has(.ba__range:focus-visible) .ba__handle span { outline: 3px solid var(--focus); outline-offset: 4px; }
  .ba__tag {
    position: absolute;
    top: 14px;
    padding: 0.3rem 0.6rem;
    border-radius: var(--r-s);
    background: rgb(29 33 37 / 0.78);
    color: #fff;
    font-size: var(--step--1);
    font-weight: 600;
    pointer-events: none;
  }
  .ba__tag--before { left: 14px; }
  .ba__tag--after { right: 14px; }
  .ba__caption { display: grid; gap: 0.35rem; margin-top: 0.85rem; color: var(--ink-2); font-size: 0.9375rem; max-width: 80ch; }
  .ba__credit { font-size: var(--step--1); }
  @media (max-width: 600px) {
    .ba__frame { aspect-ratio: 4 / 3; }
  }
</style>

<script>
  import { animate } from 'animejs';
  import { inView } from 'motion';
  import { prefersReducedMotion } from '../../lib/motion';

  const root = document.querySelector<HTMLElement>('[data-ba]');
  const range = root?.querySelector<HTMLInputElement>('[data-ba-range]');

  if (root && range) {
    const set = (v: number) => {
      root.style.setProperty('--pos', `${v}%`);
      const text =
        v <= 2 ? 'Целиком фото после ремонта' : v >= 98 ? 'Целиком фото до ремонта' : `Слева ${Math.round(v)}% фото до ремонта, справа после`;
      range.setAttribute('aria-valuetext', text);
    };
    range.addEventListener('input', () => set(Number(range.value)));

    // The first time the slider scrolls into view, the handle nudges once to show it moves.
    if (!prefersReducedMotion()) {
      const stop = inView(root, () => {
        stop();
        const state = { v: 50 };
        animate(state, {
          v: [50, 34, 64, 50],
          duration: 1600,
          ease: 'inOut(2)',
          delay: 300,
          onUpdate: () => {
            if (document.activeElement !== range) root.style.setProperty('--pos', `${state.v}%`);
          },
        });
      }, { amount: 0.6 });
    }
  }
</script>
